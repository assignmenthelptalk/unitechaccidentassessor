---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pageTitle?: string;
}

const { title, description, pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="site-brand" href="/">
            <span class="site-brand__mark">UA</span>
            <span>
              <strong>Unitech Accident Assessor</strong>
              <small>Valuation and assessment services in Kenya</small>
            </span>
          </a>

          <nav class="site-nav" aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/services/pre-purchase-vehicle-valuation/">Pre-Purchase Valuation</a>
            <a href="/insights/">Insights</a>
            <a href="#contact">Contact</a>
          </nav>

          <div class="site-header__actions">
            <a
              class="whatsapp-button"
              href="https://wa.me/254755668653"
              target="_blank"
              rel="noreferrer"
            >
              WhatsApp Chat
            </a>
          </div>
        </div>
      </header>

      {pageTitle && (
        <section class="page-hero">
          <div class="page-hero__inner">
            <p class="eyebrow">Unitech Accident Assessor</p>
            <h1>{pageTitle}</h1>
          </div>
        </section>
      )}

      <slot />

      <footer class="site-footer" id="contact">
        <div class="site-footer__inner">
          <div>
            <p class="eyebrow">Contact Unitech</p>
            <h2>Vehicle valuation support you can act on.</h2>
            <p>
              For valuation, accident assessment, pre-purchase checks, and insurer-ready reports,
              contact Unitech Accident Assessor.
            </p>
          </div>

          <div class="site-footer__contact">
            <a href="tel:+254755668653">+254 755 668 653</a>
            <a href="https://wa.me/254755668653" target="_blank" rel="noreferrer">
              Chat on WhatsApp
            </a>
            <a href="mailto:info@unitechaccidentassessor.co.ke">
              info@unitechaccidentassessor.co.ke
            </a>
            <p>Nairobi, Kenya</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
